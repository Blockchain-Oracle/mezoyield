# MezoYield keeper bot env vars.
#
# Copy this file to packages/keeper/.env (gitignored) and fill in the
# real values. The keeper EOA is the address whose private key is
# allowed to call `castOptimalVote()` on the optimizer (set at deploy
# time; rotatable via `setKeeper(newKeeper)` from the contract owner).

# Hex-encoded 32-byte private key (0x-prefixed) for the keeper EOA.
# In the demo deploy this matches the deployer key set in
# packages/contracts/.env, since the deployer is also the keeper.
KEEPER_PRIVATE_KEY=

# RPC URL — defaults to Mezo Testnet. Override for mainnet later.
KEEPER_RPC_URL=https://rpc.test.mezo.org

# Optional Discord webhook for vote-cast notifications. Leave blank
# to skip notifications. Format: https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_URL=
