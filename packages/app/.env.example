# Mezo Passport requires a WalletConnect Cloud Project ID
# Create one at https://cloud.walletconnect.com — free.
# Without a real ID, WalletConnect-using mobile wallets won't connect,
# but injected wallets (MetaMask, Xverse, Unisat) still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Goldsky subgraph for gauge data (STORY-005). Optional — falls back to RPC.
NEXT_PUBLIC_GOLDSKY_GAUGES_URL=
