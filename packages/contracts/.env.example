# DEPLOYER_PRIVATE_KEY — secp256k1 hex (0x-prefixed, 32 bytes) for the wallet
# that runs `pnpm --filter @mezoyield/contracts run deploy:testnet`. Generate
# locally; never commit. Faucet the resulting address at
# https://faucet.test.mezo.org before deploying.
DEPLOYER_PRIVATE_KEY=

# Optional override; default is https://rpc.test.mezo.org per Mezo docs.
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
